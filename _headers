# Cloudflare Pages başlıkları
# Service worker ve giriş sayfası her açılışta yeniden denetlenir (güncellemeler hemen bulunur).
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
# Derlenen dosyaların adında içerik özeti var: değişmez, uzun süre önbellekte kalabilir.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/manifest.webmanifest
  Content-Type: application/manifest+json
